# MongoDB connection string (MongoDB Atlas: Database > Connect > Drivers)
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
# Database name (optional, default: oral_health)
MONGODB_DB="oral_health"

# Admin login (one account). Use a strong password.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-to-a-long-password"
# Random secret, at least 32 characters. Generate with:  openssl rand -base64 48
AUTH_SECRET=""

# Time zone used for dates in the admin area and CSV export (optional)
APP_TIMEZONE="Asia/Dhaka"
